<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>motely-mcp</AssemblyName>
    <RootNamespace>Motely.MCP</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Same reasoning as Motely.CLI: NativeAOT targets baseline x86-64 unless told otherwise,
         which drops every Vector256/Vector512 op to software. v3 runs on any AVX2 CPU. -->
    <IlcInstructionSet
      Condition="'$(IlcInstructionSet)' == '' and ($(RuntimeIdentifier.EndsWith('-x64')) or ('$(RuntimeIdentifier)' == '' and $(NETCoreSdkRuntimeIdentifier.EndsWith('-x64'))))"
      >x86-64-v3</IlcInstructionSet
    >
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MCP App view ships inside the binary: one file on disk, nothing to lose. -->
    <EmbeddedResource Include="app.html" LogicalName="Motely.MCP.app.html" />
  </ItemGroup>
</Project>
