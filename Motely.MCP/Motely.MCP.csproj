<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Motely.MCP: the MCP server (Streamable HTTP) and the AG-UI endpoint, behind one ASP.NET
       Core host. A long-running service, so no NativeAOT (unlike Motely.CLI): the JIT picks the
       host ISA by itself, and ASP.NET Core + AOT is a poor fit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPublishable>false</IsPublishable>
    <RootNamespace>Motely.MCP</RootNamespace>
    <!-- MCP Apps is an evaluation extension (MCPEXP003); we ship it deliberately. -->
    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" />
    <PackageReference Include="AGUI.Server" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.ServiceDefaults\Motely.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
