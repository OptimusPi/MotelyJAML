<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MotelyMCP</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <!-- Party workers are Motely.CLI processes: build it first, then ship it in cli/. -->
    <ProjectReference Include="..\Motely.CLI\Motely.CLI.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyMotelyCli" AfterTargets="Build">
    <ItemGroup>
      <MotelyCliFiles Include="..\Motely.CLI\bin\$(Configuration)\$(TargetFramework)\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MotelyCliFiles)" DestinationFolder="$(OutDir)cli" SkipUnchangedFiles="true" />
  </Target>
</Project>
