<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine as an MCP server for this machine: stdin/stdout, or Streamable HTTP under Aspire.
       Runs on the JIT (it picks the host ISA by itself); only the CLI publishes with NativeAOT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Motely.MCP</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core only (no hosting): tools are declared by hand, no reflection. -->
    <PackageReference Include="ModelContextProtocol.Core" />
    <!-- The seed database: Neon in production, Aspire's Postgres container locally. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
    <ProjectReference Include="..\Motely.ServiceDefaults\Motely.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Applied in name order at startup, once each (schema_migrations records them). -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
