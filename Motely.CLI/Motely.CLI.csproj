<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Performance optimizations -->
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- IL2104 = "a referenced assembly has trim warnings" (McMaster, DuckDB.NET.Data). We can't fix
         third-party DLLs, and Directory.Packages.props' TreatWarningsAsErrors turns it into an ilc
         warnaserror failure (MSB3077) on AOT publish. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AOT publish is ON by default. Pass -p:EnableCliAot=false to opt out. -->
    <EnableCliAot Condition="'$(EnableCliAot)' == ''">true</EnableCliAot>
    <PublishAot
      Condition="'$(EnableCliAot)' == 'true' and '$(RuntimeIdentifier)' != 'browser-wasm' and '$(DesignTimeBuild)' != 'true'"
      >true</PublishAot
    >
    <!-- NativeAOT compiles for the baseline x86-64 ISA unless told otherwise: no AVX2, no
         AVX-512, so every Vector256/Vector512 op falls back to software (~0.66M seeds/s vs
         ~4.0-4.4M with v3, at threads 1 on bench-negative-perkeo.jaml). x86-64-v3 (AVX2/FMA/BMI) measured
         fastest; v4 (AVX-512) bought nothing on that bench, and v3 runs on any AVX2 CPU.
         Override with -p:IlcInstructionSet=native for a local-only build. The JIT (dotnet
         build/run) picks the host ISA by itself and ignores this. The RID is often still empty
         here (the SDK infers it later), so fall back to the SDK's own RID. -->
    <IlcInstructionSet
      Condition="'$(IlcInstructionSet)' == '' and ($(RuntimeIdentifier.EndsWith('-x64')) or ('$(RuntimeIdentifier)' == '' and $(NETCoreSdkRuntimeIdentifier.EndsWith('-x64'))))"
      >x86-64-v3</IlcInstructionSet
    >
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <SuppressAotAnalysisWarnings>true</SuppressAotAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>
</Project>
