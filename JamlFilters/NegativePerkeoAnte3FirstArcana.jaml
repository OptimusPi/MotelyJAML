name: Negative Perkeo in Ante 3 First Arcana Pack
deck: Red
stake: White

# Target: ante 3, first booster pack is an Arcana pack that contains The Soul,
# whose legendary is Perkeo, in Negative edition.
# The soul/legendary/edition all resolve on the pack's own stream.
must:
  - legendaryJoker: Perkeo
    edition: Negative
    antes: [3]
    sources:
      boosterPacks: [0]   # first booster pack of the ante
    min: 1
