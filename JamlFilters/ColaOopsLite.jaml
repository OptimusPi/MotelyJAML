name: Cola Oops Lite
author: nat break
description: >
  Diet Cola trick without the teeth-pulling. Anaglyph gives Double Tag every boss;
  sell Diet Cola for another Double; Double copies Negative Tags → free negative jokers.
  Must: Diet Cola by ante 3, at least one Oops! early (luck pile), and one Negative Tag
  somewhere early to seed the farm. Should ranks more Oops + more Negatives.
deck: Ghost
stake: White
must:
  - smallBlindTag: NegativeTag
    antes: [4]
  - legendaryJoker: Perkeo
    score: 100
    antes: [1,2]
    sources: { boosterPacks: [0,1,2,3]}
  - spectralCard: Ankh
    antes: [1,2]
    sources:
      shopItems: [0,1,2,3]
  - legendaryJoker:
    antes: [5,6,7,8]
  - legendaryJoker: Perkeo
    antes: [1,2,3,4,5,6,7,8]
    sources: { boosterPacks: [0,1,2,3,4,5]}
    min: 2
  - joker: DietCola
    antes: [1,2,3]
should:
  - voucher: Hieroglyph
    antes: [1,2]
    score: 1
  - voucher: Petroglyph
    antes: [1,2]
    score: 1
  - joker: OopsAll6s
    score: 10
    antes: [4]
    sources:
      shopItems: [2,3,4,5,6,7,8]
  - joker: OopsAll6s
    score: 8
    antes: [5]
    sources:
      shopItems: [0,1,2,3]
  - joker: OopsAll6s
    score: 7
    antes: [6]
    sources:
      shopItems: [0,1]

  - jokers: [HangingChad, Photograph, Baron, Mime, LuckyCat, InvisibleJoker, Blueprint, Brainstorm]
    score: 10
    antes: [4]
    sources:
      shopItems: [2,3,4,5,6,7,8]
  - jokers: [HangingChad, Photograph, Baron, Mime, LuckyCat, InvisibleJoker, Blueprint, Brainstorm]
    score: 8
    antes: [5]
    sources:
      shopItems: [0,1,2,3]
  - jokers: [HangingChad, Photograph, Baron, Mime, LuckyCat, InvisibleJoker, Blueprint, Brainstorm]
    score: 7
    antes: [6]
    sources:
      shopItems: [0,1]
