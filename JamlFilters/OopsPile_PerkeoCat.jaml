name: Oops Pile · Perkeo · Lucky Cat
author: nat / grok
description: >
  A shitload of Oops! All 6s (shop + packs). Must see at least 2 Oops in antes 1–5.
  Ranks more Oops hardest, then Perkeo and Lucky Cat, then Showman (stack fuel)
  and Ankh (clone the pile). Luck stacks 2^n — two Oops = 4x, three = 8x.
  Red / White. Soft prefer on the legend + the cat so the pile still finds.
deck: Red
stake: White

must:
  # The pile. Packs open so Buffoon / Mega can dump Uncommons too.
  - joker: OopsAll6s
    antes: [1, 2, 3, 4, 5]
    min: 2
    sources:
      shopItems: [0, 1, 2, 3, 4, 5, 6, 7]
      boosterPacks: [0, 1, 2, 3, 4, 5]

should:
  # More Oops = higher score (every extra sighting through ante 8)
  - joker: OopsAll6s
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    min: 3
    score: 30
    label: oops3
    sources:
      shopItems: [0, 1, 2, 3, 4, 5, 6, 7]
      boosterPacks: [0, 1, 2, 3, 4, 5]
  - joker: OopsAll6s
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    min: 4
    score: 50
    label: oops4
    sources:
      shopItems: [0, 1, 2, 3, 4, 5, 6, 7]
      boosterPacks: [0, 1, 2, 3, 4, 5]
  - joker: OopsAll6s
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    min: 5
    score: 80
    label: oops5
    sources:
      shopItems: [0, 1, 2, 3, 4, 5, 6, 7]
      boosterPacks: [0, 1, 2, 3, 4, 5]

  # Prefer: the soul + the cat
  - legendaryJoker: Perkeo
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    score: 100
    label: perkeo
    sources:
      boosterPacks: [0, 1, 2, 3, 4, 5]
  - joker: LuckyCat
    antes: [1, 2, 3, 4, 5, 6, 7, 8]
    score: 90
    label: luckycat
    sources:
      shopItems: [0, 1, 2, 3, 4, 5, 6, 7]
      boosterPacks: [0, 1, 2, 3, 4, 5]

  # Stack / clone helpers
  - joker: Showman
    antes: [1, 2, 3, 4, 5]
    score: 40
    label: showman
    sources:
      shopItems: [0, 1, 2, 3, 4, 5, 6, 7]
      boosterPacks: [0, 1, 2, 3, 4, 5]
  - spectralCard: Ankh
    antes: [1, 2, 3, 4]
    score: 35
    label: ankh
    sources:
      shopItems: [0, 1, 2, 3, 4, 5, 6, 7]
      boosterPacks: [0, 1, 2, 3, 4, 5]
  - joker: Blueprint
    antes: [1, 2, 3, 4, 5]
    score: 15
  - joker: Brainstorm
    antes: [1, 2, 3, 4, 5]
    score: 15

# Known multi-Oops seeds from OopsPile (sanity / re-rank under this scorer)
seeds:
  - 2LOL2
  - B8B
  - AXA
  - FVF
  - 9WW9
  - UFU
  - V88V
