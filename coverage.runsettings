<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- MotelyVectorUtils: 138 of 202 statements are AdvSimd/PackedSimd/scalar fallbacks
               unreachable on this x86 AVX-512 host (board section D). Operator-approved exclude;
               the ARM64 cobertura-merge verb re-credits the file honestly and removes this line. -->
          <ExcludeByFile>**/Motely/MotelyVectorUtils.cs,**/*.g.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
