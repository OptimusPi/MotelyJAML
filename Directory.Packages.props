<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Motely: JAML through YamlDotNet's static deserializer, generated by the Vecc analyzer
         (no reflection). Keep the two versions equal. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />

    <!-- Motely.CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />

    <!-- Motely.MCP: the protocol, and the seed database (Neon in production, Aspire's Postgres
         container locally). -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- Motely.Wasm: Bootsharp. Bootsharp.FileSystem is a sponsor package from the rewaffle feed
         (nuget.config maps it there). -->
    <PackageVersion Include="Bootsharp" Version="0.9.0" />
    <PackageVersion Include="Bootsharp.Inject" Version="0.9.0" />
    <PackageVersion Include="Bootsharp.FileSystem" Version="2026.4.30.1559" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />

    <!-- Motely.ServiceDefaults: traces and metrics to the Aspire dashboard. -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />

    <!-- Motely.AppHost, and Aspire.Hosting.Testing in Motely.Tests: one Aspire release
         throughout, the same as Motely.AppHost's Aspire.AppHost.Sdk. -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.1" />

    <!-- Motely.Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
    <PackageVersion Include="Verify.Xunit" Version="28.6.0" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.1.2" />
  </ItemGroup>
</Project>
