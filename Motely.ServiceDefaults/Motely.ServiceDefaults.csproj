<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aspire service defaults for Motely's console apps. The web template's version needs
       ASP.NET Core and the generic host; the CLI has neither and publishes with NativeAOT, so this
       is the "custom service defaults" shape from the Aspire docs: OpenTelemetry over OTLP only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAspireSharedProject>true</IsAspireSharedProject>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>
