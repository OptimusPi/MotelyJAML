<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    No <clear /> on purpose: lets per-user NuGet.Config sources merge in.
    Bootsharp.FileSystem (sponsor) is NOT on nuget.org — add it at user level only:
      macOS/Linux: ~/.config/NuGet/NuGet.Config
      Windows: %APPDATA%\NuGet\NuGet.Config
      macOS: ~/.nuget/NuGet/NuGet.Config (dotnet CLI) and/or ~/.config/NuGet/NuGet.Config
    Only Motely.Wasm uses it, and only with MotelyFileSystem=true (npm run build); every other
    build, including `npm run build:no-fs`, restores from nuget.org alone. See Motely.Wasm/README.md.

    CPM + TreatWarningsAsErrors: two sources without mapping → NU1507. Map so only
    Bootsharp.FileSystem may come from rewaffle; everything else from nuget.org.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="rewaffle">
      <package pattern="Bootsharp.FileSystem" />
    </packageSource>
  </packageSourceMapping>
</configuration>
