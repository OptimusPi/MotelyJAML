<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>false</IsPublishable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>$(MotelyVersion)</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- JAML clauses are read by reflection (JamlClauseFormatter). This descriptor travels
       inside Motely.dll and tells the trimmer / NativeAOT / WASM to keep all of Motely. -->
  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>

  <!-- Packages (versions from Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="VYaml" />
    <PackageReference Include="VYaml.Annotations" />
  </ItemGroup>
</Project>
