<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>false</IsPublishable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>$(MotelyVersion)</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- YDNG001: the static generator can't register an interface. IMotelyClause is discriminated
         at deserialize time via YamlDotNet's type-discriminating node deserializer. -->
    <NoWarn>$(NoWarn);YDNG001</NoWarn>
  </PropertyGroup>

  <!-- Packages (versions from Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" />
  </ItemGroup>
</Project>
