<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>false</IsPublishable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>$(MotelyVersion)</Version>
    <!-- The CLI and Motely.Wasm both NativeAOT-compile the engine: surface trim/AOT warnings at
         build time here, not only at publish. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- YDNG001: the static generator can't register an interface. IMotelyClause is read by
         ClauseNodeDeserializer (YamlConfigLoader.cs) before the generated code is asked. -->
    <NoWarn>$(NoWarn);YDNG001</NoWarn>
  </PropertyGroup>

  <!-- Packages (versions from Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" />
  </ItemGroup>
</Project>
