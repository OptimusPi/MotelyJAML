<Project Sdk="Microsoft.NET.Sdk">
  <!-- The browser build of the engine: Bootsharp exports the engine's own types, no wrappers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>Motely.Wasm</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BootsharpName>motely-wasm</BootsharpName>
    <!-- Bootsharp rewrites package.json from its template on every publish; keep that copy in obj
         so the hand-written package.json (version, files, scripts) stays. -->
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)/obj/pkg</BootsharpPackageDirectory>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>
</Project>
