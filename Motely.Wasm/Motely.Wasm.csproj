<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>Motely.Wasm</AssemblyName>
    <RootNamespace>Motely.Wasm</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL2104 / IL3053 = a referenced assembly (VYaml) has trim / AOT analysis warnings. We can't fix
         third-party DLLs, and Directory.Build.props' TreatWarningsAsErrors turns them into ilc errors. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BootsharpName>motely-wasm</BootsharpName>
    <!-- PackageTemplate.json has no version and overwrites this project's package.json. Park it. -->
    <BootsharpPackageDirectory>$(MSBuildProjectDirectory)\obj</BootsharpPackageDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bootsharp" />
    <PackageReference Include="Bootsharp.Inject" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Sponsor-feed only (nuget.pkg.github.com/rewaffle). Restore needs the user-level
         `rewaffle` source; see nuget.config. -->
    <PackageReference Include="Bootsharp.FileSystem" />
    <PackageReference Include="VYaml" GeneratePathProperty="true" />
    <PackageReference Include="VYaml.Annotations" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motely\Motely.csproj" />
  </ItemGroup>

</Project>
