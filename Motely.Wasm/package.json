{
  "name": "motely-wasm",
  "version": "29.0.0",
  "description": "Motely, the Balatro seed engine, as a single-threaded WebAssembly module (NativeAOT-LLVM via Bootsharp).",
  "license": "MIT",
  "type": "module",
  "main": "./bin/motely-wasm/index.mjs",
  "types": "./bin/motely-wasm/index.d.mts",
  "exports": {
    ".": "./bin/motely-wasm/index.mjs",
    "./*": "./bin/motely-wasm/generated/modules/*.g.mjs"
  },
  "browser": {
    "node:fs": false,
    "node:url": false,
    "node:path": false,
    "node:module": false,
    "node:crypto": false,
    "node:process": false
  },
  "files": ["bin/motely-wasm"],
  "scripts": {
    "prepack": "npm run build",
    "build": "dotnet publish -c Release",
    "build:nofs": "dotnet publish -c Release -p:MotelyFileSystem=false",
    "test": "node tests/smoke.mjs"
  }
}
