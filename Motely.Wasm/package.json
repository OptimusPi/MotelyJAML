{
    "name": "motely-wasm",
    "version": "26.0.3",
    "description": "Balatro seed search + per-seed analysis via JAML. Same Motely engine as native, compiled to WebAssembly (Bootsharp).",
    "author": "Nathanial P. Howard",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OptimusPi/MotelyJAML.git"
    },
    "type": "module",
    "files": [
        "bin/motely-wasm"
    ],
    "main": "./bin/motely-wasm/index.mjs",
    "types": "./bin/motely-wasm/index.d.mts",
    "exports": {
        ".": {
            "types": "./bin/motely-wasm/index.d.mts",
            "default": "./bin/motely-wasm/index.mjs"
        },
        "./*": {
            "types": "./bin/motely-wasm/generated/modules/*.g.d.mts",
            "default": "./bin/motely-wasm/generated/modules/*.g.mjs"
        },
        "./package.json": "./package.json"
    },
    "browser": {
        "node:fs": false,
        "node:url": false,
        "node:path": false,
        "node:module": false,
        "node:crypto": false,
        "node:process": false
    },
    "peerDependencies": {
        "@rewaffle/bootsharp-file-system": "*"
    },
    "peerDependenciesMeta": {
        "@rewaffle/bootsharp-file-system": {
            "optional": true
        }
    },
    "scripts": {
        "build": "dotnet publish Motely.Wasm.csproj -c Release && node scripts/patch-dist-base64-polyfill.mjs",
        "prepublishOnly": "npm run build"
    }
}
