{
  "name": "motely-wasm",
  "version": "31.1.0",
  "description": "Motely, the Balatro seed engine, as a single-threaded WebAssembly module (NativeAOT-LLVM via Bootsharp).",
  "keywords": ["balatro", "seed", "seed-finder", "motely", "yaml", "webassembly", "wasm", "nativeaot", "bootsharp"],
  "license": "MIT",
  "type": "module",
  "main": "./bin/motely-wasm/index.mjs",
  "types": "./bin/motely-wasm/index.d.mts",
  "exports": {
    ".": "./bin/motely-wasm/index.mjs",
    "./jaml": {
      "types": "./jaml/index.d.ts",
      "default": "./jaml/index.mjs"
    },
    "./jaml/schema.json": "./jaml/motely-filter.schema.json",
    "./*": "./bin/motely-wasm/generated/modules/*.g.mjs"
  },
  "browser": {
    "node:fs": false,
    "node:url": false,
    "node:path": false,
    "node:module": false,
    "node:crypto": false,
    "node:process": false
  },
  "files": ["bin/motely-wasm", "jaml"],
  "scripts": {
    "prepack": "npm run build",
    "build": "dotnet publish -c Release",
    "build:nofs": "dotnet publish -c Release -p:MotelyFileSystem=false",
    "test": "node --test \"tests/*.test.mjs\"",
    "cover": "node --test --experimental-test-coverage --test-coverage-include=bin/motely-wasm/index.mjs --test-coverage-include=bin/motely-wasm/generated/** --test-coverage-include=tests/** \"tests/*.test.mjs\""
  },
  "peerDependencies": {
    "@rewaffle/bootsharp-file-system": "*"
  },
  "peerDependenciesMeta": {
    "@rewaffle/bootsharp-file-system": { "optional": true }
  },
  "devDependencies": {
    "@rewaffle/bootsharp-file-system": "2026.5.201827"
  }
}
